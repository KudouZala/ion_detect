# ---------- output 规则 ----------
# 忽略 output 下所有第一层内容
/output/*

# 允许 output 目录本身被跟踪
!/output
!/output/.gitkeep

# 放行两个父目录（否则下面的子目录无法被重新包含）
!/output/trained_model_save
!/output/inference_results

# 重新忽略这两个父目录下的所有内容（为“只放行某个版本”做准备）
/output/trained_model_save/*
/output/inference_results/*


# ---------- datasets 规则 ----------
# 忽略 datasets 下所有第一层内容
/datasets/*

# 允许 datasets 目录本身被跟踪
!/datasets
!/datasets/.gitkeep


# ---------- data 规则 ----------
# 忽略 data 第一层
/data/*

# 放行 scripts 目录及全部内容
!/data/scripts
!/data/scripts/**

# 只忽略 data/logs 的内容，但保留目录（需要占位文件）
/data/logs/**
!/data/logs
!/data/logs/.gitkeep


# ---------- 其他 ----------
scripts/save_three_system

# ---------- logs（训练/运行日志，不提交）----------
# 任意路径下的 .log 文件（勿使用 **/logs/ 全库匹配，以免覆盖 /data/logs 的 .gitkeep 例外）
**/*.log
/logs/
scripts/machine_learning_code/logs/
scripts/machine_learning_code/logs_*/
scripts/machine_learning_code/debug_logs/

# Python cache / bytecode
**/__pycache__/
*.pyc
*.pyo

# Root runtime artifacts
/exp_new_.zip
/exp_new_/

